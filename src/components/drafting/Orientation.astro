---
/* North arrow + graphic scale bar, as found in a drawing's corner. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["flex items-end gap-6 text-paper", className]} aria-hidden="true">
  <svg viewBox="0 0 40 52" class="h-12 w-9" fill="none" stroke="currentColor" stroke-width="1.5">
    <circle cx="20" cy="32" r="18" />
    <path d="M20 8 28 40 20 34 12 40z" fill="currentColor" />
    <text x="20" y="6" text-anchor="middle" fill="currentColor" stroke="none" font-family="var(--font-mono)" font-size="8">N</text>
  </svg>
  <div>
    <div class="flex h-2 w-40 border border-current md:w-56">
      <span class="flex-1 bg-current"></span><span class="flex-1"></span><span class="flex-[2] bg-current"></span><span class="flex-[4]"></span>
    </div>
    <div class="annot relative mt-1 h-3 w-40 md:w-56">
      {[["0", 0], ["1", 12.5], ["2", 25], ["5", 50], ["10 m", 100]].map(([t, x]) => (
        <span class="absolute -translate-x-1/2 last:translate-x-[-70%]" style={`left:${x}%`}>{t}</span>
      ))}
    </div>
  </div>
</div>
