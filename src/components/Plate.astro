---
/*
  The signature block, after the brutalist poster reference:
  giant display word + corner arrow, a bold uppercase subhead,
  an asterisk-led note, a right-aligned meta figure, then a
  full-bleed image (slot "media") butted against the paper.

  As h1 it animates on page load; as h2 it animates on scroll.
*/
import Icon from "./Icons.astro";
import Dimension from "./drafting/Dimension.astro";
import Orientation from "./drafting/Orientation.astro";

interface Props {
  title: string;
  subtitle: string;
  note?: string;
  meta?: string;
  href?: string;
  as?: "h1" | "h2";
  size?: "mega" | "huge";
  id?: string;
  cursor?: string;
  /** Dimension string drawn under the headline, e.g. "12 400". */
  dimension?: string;
  /** Coordinate crosshair, north arrow and scale bar over the media. */
  survey?: boolean;
}

const { title, subtitle, note, meta, href, as: Heading = "h2", size = "huge", id, cursor, dimension, survey } = Astro.props;
const Tag = href ? "a" : "div";
const hero = Heading === "h1";
---

<section id={id} class="px-frame">
  <div class="plate relative">
    <span class="crop pointer-events-none absolute inset-2 md:inset-3" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <Tag href={href} class="group block px-5 pt-6 pb-8 sm:px-8 md:px-12 md:pt-10 md:pb-10">
      <div class="flex items-start justify-between gap-4">
        <Heading class:list={["display", size === "mega" ? "text-mega" : "text-huge"]} data-split={hero ? "load" : ""}>
          <Fragment set:html={title} />
        </Heading>
        {href && (
          <span data-magnetic="0.4" class="shrink-0" data-fade>
            <Icon
              name="arrow"
              class="size-10 transition-transform duration-700 ease-out-expo group-hover:rotate-45 sm:size-16 md:size-24"
            />
          </span>
        )}
      </div>

      {dimension && <Dimension label={dimension} class="mt-4 text-concrete-dark md:mt-6" />}

      <div class="mt-8 grid items-end gap-6 md:mt-14 md:grid-cols-12">
        <div class="md:col-span-6 lg:col-span-5" data-fade>
          <p class="font-display text-base leading-tight font-bold uppercase md:text-lg">
            <Fragment set:html={subtitle} />
          </p>
          {note && (
            <div class="mt-5 flex gap-4">
              <Icon name="asterisk" class="mt-0.5 size-6 shrink-0 text-brand transition-transform duration-1000 ease-out-expo group-hover:rotate-180 md:size-7" />
              <p class="max-w-md text-sm leading-relaxed text-concrete-dark">{note}</p>
            </div>
          )}
        </div>
        {meta && (
          <p class="font-display text-2xl font-medium tracking-tight md:col-span-6 md:text-right md:text-4xl lg:col-span-7" data-fade>
            {meta}
          </p>
        )}
      </div>
    </Tag>
  </div>
  {Astro.slots.has("media") && (
    <div class="relative overflow-hidden bg-ink-3" data-clip={hero ? "" : undefined} data-expand={hero ? undefined : ""} data-cursor={survey ? undefined : cursor} data-crosshair={survey ? "" : undefined}>
      <div data-parallax="0.12">
        <slot name="media" />
      </div>
      {survey && (
        <>
          <div class="crosshair" aria-hidden="true">
            <span class="crosshair-x"></span><span class="crosshair-y"></span>
            <span class="crosshair-readout annot"></span>
          </div>
          <Orientation class="pointer-events-none absolute bottom-4 left-4 md:bottom-8 md:left-8" />
          <span class="annot pointer-events-none absolute right-4 bottom-4 text-paper md:right-8 md:bottom-8" aria-hidden="true">ÖLÇEK 1:100 · A-000</span>
        </>
      )}
    </div>
  )}
</section>
